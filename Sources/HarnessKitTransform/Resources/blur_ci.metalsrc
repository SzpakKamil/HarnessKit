//
//  blur_ci.metal
//  ForkedGlur
//
//  CoreImage twin of the SwiftUI Metal shader in `blur.metal`. Same
//  Gaussian math, same scaled sampling step, same float-precision
//  accumulator, same no-clamp halo behavior — the ONLY differences
//  are the entry-point signature (CIKernel's `coreimage::sampler` vs
//  SwiftUI's `SwiftUI::Layer`) and the sampling call
//  (`src.sample(src.transform(pixel))` vs `layer.sample(pixel)`).
//
//  This file is shipped as a RAW resource, not compiled into the
//  package's default.metallib. `HeadlessBlur.swift` reads the source
//  at runtime and hands it to `CIKernel.kernels(withMetalString:)`,
//  which applies the `-fcikernel` compile flag CoreImage needs. The
//  SwiftUI stitchable shaders can't share a metallib with CI kernels
//  because the same Metal file can't be compiled both ways — doing so
//  leaves `coreimage::Sampler::sample`, `::coord`, `::transform` as
//  undefined symbols at `air-lld` time.
//
//  Any bug fix to the Gaussian math needs a matching change in
//  `blur.metal` (and vice versa). Helpers are duplicated verbatim —
//  not great, but ~20 lines each, and sharing headers across the two
//  compile paths runs into the same -fcikernel split.
//

#include <metal_stdlib>
#include <CoreImage/CoreImage.h>
using namespace metal;

#define kernelSize (64)

float mapRadius(float2 position,
                float2 contentOrigin,
                float2 size,
                float offset,
                float interpolation,
                float radius,
                float direction) {
    // Position is in apply-extent coords; when the caller pads the
    // source bitmap (so blur halo can render beyond the frame), the
    // extent is larger than the authored frame and the content sits
    // centered inside. Shifting by `contentOrigin` puts
    // `position.y / size.y` at 0 at the frame's TOP edge and 1 at
    // the frame's BOTTOM edge — matching what Framely's preview
    // shader sees when it runs on a view sized exactly to the frame.
    // Without this shift the gradient stretches across the padded
    // extent and the content sees a compressed range (e.g. 0.23 →
    // 0.77 of `radius` instead of 0 → `radius`), which reads as a
    // visibly weaker / shifted blur in the export.
    float2 contentPos = position - contentOrigin;
    float mapped = 0.0;

    if (direction == 0) {
        mapped = max((contentPos.y/size.y-offset)/interpolation, 0.0);
    } else if (direction == 1) {
        mapped = max(0.5-(contentPos.y/size.y-offset)/interpolation, 0.0);
    } else if (direction == 2) {
        mapped = max((contentPos.x/size.x-offset)/interpolation, 0.0);
    } else if (direction == 3) {
        mapped = max(0.5-(contentPos.x/size.x-offset)/interpolation, 0.0);
    }

    return min(mapped*radius, radius);
}

float sampleStep(float radius) {
    return max(1.0, (6.0 * radius) / float(kernelSize - 1));
}

int centerIndex() {
    return (kernelSize - 1) / 2;
}

void calculateGaussianWeights(float radius,
                              thread float weights[]) {
    float sum = 0.0;
    float step = sampleStep(radius);
    int center = centerIndex();

    for (int i = 0; i < kernelSize; ++i) {
        float x = float(i - center) * step;
        weights[i] = exp(-(x*x)/(2.0*radius*radius));
        sum+= weights[i];
    }

    for (int i = 0; i < kernelSize; ++i) {
        weights[i]/= sum;
    }
}

// X-axis pass — progressive blur along the horizontal axis.
// `src.coord()` is the destination pixel position in the sampler's
// natural space (== output pixel coordinate for a 1:1 sampler).
// `src.transform(pixel)` converts a pixel-space coord to the
// sampler's input space so `src.sample(...)` can read it regardless
// of any transform CoreImage has baked in.
//
// Uses the `[[stitchable]]` attribute (not the legacy `extern "C" {
// namespace coreimage { ... } }` wrapper) because that's the form
// `CIKernel.kernels(withMetalString:)` recognizes — the legacy
// wrapper ships in a compiled .metallib but can't be discovered
// from a Metal source string at runtime.
[[stitchable]] half4 blurX_ci(coreimage::sampler src,
                              float radius,
                              float offset,
                              float interpolation,
                              float direction,
                              float2 contentOrigin,
                              float2 size) {
    float2 position = src.coord();
    float r = mapRadius(position,
                        contentOrigin,
                        size,
                        offset,
                        interpolation,
                        radius,
                        direction);

    if (r == 0) {
        return half4(src.sample(src.transform(position)));
    }

    float weights[kernelSize];
    calculateGaussianWeights(r, weights);
    float step = sampleStep(r);
    int center = centerIndex();

    float4 result = float4(0.0);
    for (int i = 0; i < kernelSize; ++i) {
        float sampleOffset = float(i - center) * step;
        float2 samplePixel = float2(position.x + sampleOffset, position.y);
        result+= float4(src.sample(src.transform(samplePixel))) * weights[i];
    }

    return half4(result);
}

// Y-axis pass — same math, samples along the vertical axis.
[[stitchable]] half4 blurY_ci(coreimage::sampler src,
                              float radius,
                              float offset,
                              float interpolation,
                              float direction,
                              float2 contentOrigin,
                              float2 size) {
    float2 position = src.coord();
    float r = mapRadius(position,
                        contentOrigin,
                        size,
                        offset,
                        interpolation,
                        radius,
                        direction);

    if (r == 0) {
        return half4(src.sample(src.transform(position)));
    }

    float weights[kernelSize];
    calculateGaussianWeights(r, weights);
    float step = sampleStep(r);
    int center = centerIndex();

    float4 result = float4(0.0);
    for (int i = 0; i < kernelSize; ++i) {
        float sampleOffset = float(i - center) * step;
        float2 samplePixel = float2(position.x, position.y + sampleOffset);
        result+= float4(src.sample(src.transform(samplePixel))) * weights[i];
    }

    return half4(result);
}
